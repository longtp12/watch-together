# Chép file này thành web/.env.local để chạy webapp trên máy với config Firebase của bạn.
# Không bắt buộc: nếu không có file này thì webapp dùng src/firebase-config.js.
# Trên Vercel, đặt các biến này trong Settings -> Environment Variables.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
