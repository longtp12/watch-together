{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && $code.matches(/^[A-Z0-9]{6}$/)",
        "url": { ".validate": "newData.isString() && newData.val().length < 500" },
        "playback": {
          ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          ".validate": "newData.hasChildren(['paused', 'time', 'updatedAt', 'by']) && newData.child('paused').isBoolean() && newData.child('time').isNumber() && newData.child('by').val() === auth.uid"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || newData.child('name').isString() && newData.child('name').val().length <= 30"
          }
        },
        "chat": {
          "$msg": {
            ".write": "auth != null && !data.exists() && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
            ".validate": "newData.child('uid').val() === auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 500"
          }
        }
      }
    }
  }
}
